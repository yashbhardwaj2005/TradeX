NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/tradeforge?replicaSet=rs0
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
MARKET_PROVIDER=simulated
MAX_QUOTE_AGE_MS=120000
WORKER_ENABLED=true
WORKER_INTERVAL_MS=15000
# Set to 1 behind exactly one trusted reverse proxy (Render).
TRUST_PROXY=0
# Optional: serve the built React app from the API (single-service deployment).
SERVE_FRONTEND=false
# PUBLIC_APP_URL=https://your-tradex-app.onrender.com
